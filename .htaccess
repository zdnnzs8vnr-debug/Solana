# ============================================================
# GUSTAVOEURO — hardening Apache
# ============================================================

# ---------- Forza HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Directory ----------
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------- Header di sicurezza ----------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://i.ibb.co https://api.qrserver.com; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-DNS-Prefetch-Control "off"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Server "ge-node"
  Header unset X-Powered-By
  Header unset ETag
</IfModule>

# ---------- Blocca bot SEO ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|BLEXBot|Bytespider|DataForSeoBot|ScreamingFrog) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ---------- Blocca file nascosti (tranne .well-known) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule "(^|/)\." - [F]
</IfModule>

# ---------- Blocca user-agent vuoto / scanner ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteRule .* - [F,L]
</IfModule>

# ---------- SPA: rotte hash, 404 -> 404.html ----------
ErrorDocument 404 /404.html

# ---------- MIME ----------
AddType text/plain .txt
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# ---------- Compressione ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------- Cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# ---------- Niente listato se manca index ----------
<IfModule mod_autoindex.c>
  IndexIgnore .??* *~ *# HEADER* README* RCS CVS *,v *,t
</IfModule>
